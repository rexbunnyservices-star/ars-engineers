---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';

const title = 'Coal Crushers | ARS Engineers & Technology';
const desc = 'Specialized single-roll coal crushers for coal processing. 20 TPH capacity. Manufactured in New Delhi.';

const specs = [
  { label: 'Type', value: 'Single Roll Crusher' },
  { label: 'Capacity', value: '20 TPH' },
  { label: 'Feed Size', value: 'Up to 400 mm' },
  { label: 'Output Size', value: '20 mm – 40 mm' },
  { label: 'Motor Power', value: '15 HP – 25 HP' },
  { label: 'Roll Speed', value: '100 – 200 RPM' },
  { label: 'Construction', value: 'Heavy Duty MS Frame' },
  { label: 'Roll Material', value: 'Manganese Steel / Hi-Chrome' },
  { label: 'Adjustable Gap', value: 'Yes — output size control' },
  { label: 'Dust Control', value: 'Water spray attachment optional' },
  { label: 'Application', value: 'Coal crushing for power plants, boilers, brick kilns' },
];

const related = [
  { name: 'Hammer Crushers', description: 'High-impact secondary crushers for medium-hard materials.', price: 'Contact for Price', icon: 'ri-hammer-line', href: '/products/hammer-crushers' },
  { name: 'Belt Conveyors', description: 'Flat, troughed & inclined belt conveyors for continuous material handling.', price: 'From ₹25,000', icon: 'ri-arrow-right-line', href: '/products/belt-conveyors' },
  { name: 'Screw Conveyors', description: 'Inclined & vertical screw conveyors for bulk material transport.', price: 'From ₹1 Lakh', icon: 'ri-loop-right-line', href: '/products/screw-conveyors' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Coal Crushers
      </p>
      <h1 class="product-hero__title">Coal Crushers</h1>
      <p class="product-hero__desc">
        Our single-roll coal crushers are purpose-built for the coal processing industry. With a robust manganese steel roll and adjustable gap settings, they consistently produce 20–40 mm output from raw coal feed up to 400 mm in size.
      </p>
      <p class="product-hero__desc">
        Ideal for thermal power plants, brick kilns, and industrial boilers, these crushers handle high-moisture coal without clogging. Optional water spray systems help manage dust at the crushing point.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    <div class="product-hero__img">
      <img src="/images/coal-crusher.jpg" alt="ARS Coal Crusher Machine - single roll, 20 TPH" width="600" height="400" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SpecTable specs={specs} />
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div style="display:grid; grid-template-columns: repeat(3,1fr); gap: var(--sp-4);">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div class="cta-band__inner">
        <div>
          <h2 class="cta-band__title">Need a Coal Crusher?</h2>
          <p class="cta-band__text">Tell us your coal type and required output size.</p>
        </div>
        <a href="/#contact" class="btn btn--white"><i class="ri-chat-3-line"></i> Get Free Quote</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cta-band { background: var(--grad); padding: var(--sp-10) 0; }
  .cta-band__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); flex-wrap: wrap; }
  .cta-band__title { font-size: var(--fs-h2); font-weight: 800; color: #fff; margin-bottom: var(--sp-1); }
  .cta-band__text { font-size: var(--fs-body); color: rgba(255,255,255,0.85); }
  @media (max-width: 720px) { .cta-band__inner { flex-direction: column; text-align: center; } [style*="grid-template-columns: repeat(3"] { grid-template-columns: 1fr !important; } }
</style>
