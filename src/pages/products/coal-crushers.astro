---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Coal Crushers | ARSM Engineering & Technology';
const desc = 'Specialized single-roll coal crushers for coal processing. 20 TPH capacity. Manufactured in New Delhi by ARSM Engineering & Technology.';

const specs = [
  { label: 'Type', value: 'Single Roll Crusher' },
  { label: 'Capacity', value: '20 TPH' },
  { label: 'Feed Size', value: 'Up to 400 mm' },
  { label: 'Output Size', value: '20 mm â€“ 40 mm' },
  { label: 'Motor Power', value: '15 HP â€“ 25 HP' },
  { label: 'Roll Speed', value: '100 â€“ 200 RPM' },
  { label: 'Construction', value: 'Heavy Duty MS Frame' },
  { label: 'Roll Material', value: 'Manganese Steel / Hi-Chrome' },
  { label: 'Adjustable Gap', value: 'Yes â€” output size control' },
  { label: 'Dust Control', value: 'Water spray attachment optional' },
  { label: 'Application', value: 'Coal crushing for power plants, boilers, brick kilns' },
];

const related = [
  { name: 'Hammer Crushers', description: 'High-impact secondary crushers for medium-hard materials.', price: 'Contact for Price', icon: 'ri-hammer-line', href: '/products/hammer-crushers' },
  { name: 'Belt Conveyors', description: 'Flat, troughed & inclined belt conveyors for continuous material handling.', price: 'From â‚¹25,000', icon: 'ri-arrow-right-line', href: '/products/belt-conveyors' },
  { name: 'Screw Conveyors', description: 'Inclined & vertical screw conveyors for bulk material transport.', price: 'From â‚¹1 Lakh', icon: 'ri-loop-right-line', href: '/products/screw-conveyors' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
  <div class="product-hero__img">
      <img src="/images/coal-crusher.png" alt="ARSM Coal Crusher Machine - single roll, 20 TPH" width="1200" height="1600" loading="eager" />
    </div>
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Coal Crushers
      </p>
      <h1 class="product-hero__title">Coal Crushers</h1>
      <p class="product-hero__desc">
        ARSM Engineering & Technology's single-roll coal crushers are purpose-built for the coal processing industry. With a robust manganese steel roll and adjustable gap settings, they consistently produce 20â€“40 mm output from raw coal feed up to 400 mm in size.
      </p>
      <p class="product-hero__desc">
        Ideal for thermal power plants, brick kilns, and industrial boilers, these crushers handle high-moisture coal without clogging. Optional water spray systems help manage dust at the crushing point.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    </section>

  <section class="section">
    <div class="container">
      <SpecTable specs={specs} />
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Need a Coal Crusher?" text="Tell us your coal type and required output size." />
</Layout>