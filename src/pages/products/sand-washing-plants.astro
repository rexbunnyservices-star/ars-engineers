---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Sand Washing Plants | ARSM Engineering & Technology';
const desc = 'Complete sand washing & screening plants for manufactured sand. Manufactured in New Delhi by ARSM Engineering & Technology.';

const variants = [
  {
    name: 'Sand Washing Plant (Wheel Type)',
    specs: [
      { label: 'Type', value: 'Wheel / Bucket Wheel Washer' },
      { label: 'Capacity', value: '20 – 100 TPH' },
      { label: 'Feed Size', value: '0 – 10 mm' },
      { label: 'Wheel Diameter', value: '2000 mm – 3500 mm' },
      { label: 'Motor Power', value: '7.5 HP – 30 HP' },
      { label: 'Water Consumption', value: '50 – 200 m³/hr' },
      { label: 'Construction', value: 'Heavy Duty MS with Anti-Corrosion Coating' },
      { label: 'Dewatering Screen', value: 'High-Frequency Polyurethane Screen' },
      { label: 'Application', value: 'Manufactured sand, river sand, quarry dust washing' },
      { label: 'Advantage', value: 'Low fine sand loss, high washing efficiency, compact' },
    ]
  },
  {
    name: 'Sand Washing Plant (Screw Type)',
    specs: [
      { label: 'Type', value: 'Spiral / Screw Sand Washer' },
      { label: 'Capacity', value: '30 – 150 TPH' },
      { label: 'Feed Size', value: '0 – 10 mm' },
      { label: 'Screw Diameter', value: '500 mm – 1200 mm' },
      { label: 'Motor Power', value: '15 HP – 50 HP' },
      { label: 'Water Consumption', value: '80 – 300 m³/hr' },
      { label: 'Construction', value: 'Heavy Duty MS / SS304 Option' },
      { label: 'Trough', value: 'U-Shaped with Wear-Resistant Lining' },
      { label: 'Application', value: 'Coarse sand, gravel, aggregate washing & dewatering' },
      { label: 'Advantage', value: 'High capacity, handles larger particles, robust' },
    ]
  },
];

const related = [
  { name: 'Vibrating Screens', description: 'Multi-deck screens for efficient material classification and sizing.', price: 'From ₹1 Lakh', icon: 'ri-layout-grid-line', href: '/products/vibrating-screens' },
  { name: 'Belt Conveyors', description: 'Flat, troughed & inclined belt conveyors for continuous material handling.', price: 'From ₹25,000', icon: 'ri-arrow-right-line', href: '/products/belt-conveyors' },
  { name: 'Crushing Plants', description: 'Complete mobile, skid-mounted & stationary crushing plant solutions.', price: 'From ₹5 Lakh', icon: 'ri-building-2-line', href: '/products/crushing-plants' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
  <div class="product-hero__img">
      <img src="/images/sand-washing-plant.png" alt="ARSM Sand Washing Plant - wheel & screw type for manufactured sand" width="800" height="800" loading="eager" />
    </div>
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Sand Washing Plants
      </p>
      <h1 class="product-hero__title">Sand Washing Plants</h1>
      <p class="product-hero__desc">
        ARSM Engineering & Technology manufactures complete sand washing and screening plants for producing high-quality manufactured sand (M-sand) and washed river sand. Our plants combine washing, dewatering, and screening in a single compact unit.
      </p>
      <p class="product-hero__desc">
        Available in wheel/bucket type and spiral/screw type configurations, our sand washing plants effectively remove clay, silt, and impurities while recovering maximum fine sand. Ideal for construction sand, concrete production, and plaster sand applications.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    </section>

  <section class="section">
    <div class="container">
      {variants.map((v) => (
        <div style="margin-bottom: var(--sp-6);">
          <h2 style="font-size: var(--fs-h3); font-weight: 700; color: var(--ink); margin-bottom: var(--sp-2);">{v.name}</h2>
          <SpecTable specs={v.specs} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Planning a Sand Washing Plant?" text="Tell us your feed material and required sand specifications." />
</Layout>