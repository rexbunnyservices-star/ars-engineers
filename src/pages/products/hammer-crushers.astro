---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Hammer Crushers | ARSM Engineering & Technology';
const desc = 'Heavy-duty hammer crushers for secondary crushing of medium-hard materials. Manufactured in New Delhi by ARSM Engineering & Technology.';

const specs = [
  { label: 'Type', value: 'Heavy-Duty Hammer Crusher' },
  { label: 'Capacity', value: '20 â€“ 100 TPH (varies by model)' },
  { label: 'Feed Size', value: 'Up to 350 mm' },
  { label: 'Output Size', value: '5 mm â€“ 25 mm' },
  { label: 'Rotor Speed', value: '800 â€“ 1200 RPM' },
  { label: 'Motor Power', value: '20 HP â€“ 75 HP' },
  { label: 'Hammers', value: 'High-Manganese / Tungsten Carbide Tips' },
  { label: 'Frame', value: 'Heavy Duty MS with Reinforced Liners' },
  { label: 'Screen', value: 'Interchangeable Grate Screen (output control)' },
  { label: 'Application', value: 'Limestone, gypsum, coal, soft to medium-hard materials' },
  { label: 'Advantage', value: 'Single-stage crushing â€” high reduction ratio (10:1 to 20:1)' },
];

const related = [
  { name: 'Jaw Crushers', description: 'Heavy-duty primary crushers for hard rock and ore processing.', price: 'From â‚¹5 Lakh', icon: 'ri-flashlight-line', href: '/products/jaw-crushers' },
  { name: 'Roll Crushers', description: 'Double-roll crushers for fine and intermediate crushing stages.', price: 'Contact for Price', icon: 'ri-circle-line', href: '/products/roll-crushers' },
  { name: 'Crushing Plants', description: 'Complete mobile, skid-mounted & stationary crushing plant solutions.', price: 'From â‚¹5 Lakh', icon: 'ri-building-2-line', href: '/products/crushing-plants' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Hammer Crushers
      </p>
      <h1 class="product-hero__title">Hammer Crushers</h1>
      <p class="product-hero__desc">
        ARSM Engineering & Technology's hammer crushers deliver exceptional reduction ratios in a single crushing stage â€” turning 350 mm feed into 5â€“25 mm product without the need for secondary crushing. The high-speed rotor with manganese steel hammers ensures consistent output and efficient energy use.
      </p>
      <p class="product-hero__desc">
        Ideal for limestone, gypsum, coal, and other soft to medium-hard materials, these crushers are widely used in cement plants, power stations, and mining operations. Interchangeable grate screens let you fine-tune the output size without changing hammers.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    <div class="product-hero__img">
      <img src="/images/hammer-crusher.png" alt="ARSM 600 mm Hammer Crusher - 20 to 100 TPH" width="800" height="800" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SpecTable specs={specs} />
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Interested in a Hammer Crusher?" text="We'll match you with the right model for your material and capacity." />
</Layout>