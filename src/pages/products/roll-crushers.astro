---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Roll Crushers | ARSM Engineering & Technology';
const desc = 'Double-roll crushers for fine and intermediate crushing. Manufactured in New Delhi, India by ARSM Engineering & Technology.';

const specs = [
  { label: 'Type', value: 'Double Roll Crusher' },
  { label: 'Capacity', value: '10 â€“ 80 TPH (varies by model)' },
  { label: 'Feed Size', value: 'Up to 200 mm' },
  { label: 'Output Size', value: '5 mm â€“ 20 mm' },
  { label: 'Roll Diameter', value: '400 mm â€“ 900 mm' },
  { label: 'Roll Width', value: '400 mm â€“ 800 mm' },
  { label: 'Motor Power', value: '10 HP â€“ 50 HP' },
  { label: 'Roll Speed', value: '50 â€“ 200 RPM' },
  { label: 'Roll Material', value: 'Manganese Steel / Hard Chrome' },
  { label: 'Spring Safety', value: 'Adjustable Spring Relief Mechanism' },
  { label: 'Application', value: 'Coal, salt, limestone, coke, fertilizers, chemicals' },
  { label: 'Advantage', value: 'Minimal fines generation, uniform product size' },
];

const related = [
  { name: 'Hammer Crushers', description: 'High-impact secondary crushers for medium-hard materials.', price: 'Contact for Price', icon: 'ri-hammer-line', href: '/products/hammer-crushers' },
  { name: 'Jaw Crushers', description: 'Heavy-duty primary crushers for hard rock and ore processing.', price: 'From â‚¹5 Lakh', icon: 'ri-flashlight-line', href: '/products/jaw-crushers' },
  { name: 'Vibrating Screens', description: 'Multi-deck screens for efficient material classification and sizing.', price: 'From â‚¹1 Lakh', icon: 'ri-layout-grid-line', href: '/products/vibrating-screens' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
  <div class="product-hero__img">
      <img src="/images/roll-crusher.png" alt="ARSM Double Roll Crusher - 10 to 80 TPH" width="800" height="800" loading="eager" />
    </div>
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Roll Crushers
      </p>
      <h1 class="product-hero__title">Roll Crushers</h1>
      <p class="product-hero__desc">
        ARSM Engineering & Technology's double-roll crushers provide controlled, consistent crushing with minimal fines generation. The two counter-rotating rolls compress and shear material between them, producing a uniform product size that's ideal for applications where particle size distribution matters.
      </p>
      <p class="product-hero__desc">
        Widely used in coal preparation, salt processing, chemical plants, and fertilizer production, these crushers feature adjustable roll gaps and spring-loaded safety mechanisms to protect against uncrushable tramp material.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    </section>

  <section class="section">
    <div class="container">
      <SpecTable specs={specs} />
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Need a Roll Crusher?" text="We'll help you choose the right roll configuration for your material." />
</Layout>