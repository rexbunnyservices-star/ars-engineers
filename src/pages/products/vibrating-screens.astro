---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Vibrating Screens | ARSM Engineering & Technology';
const desc = 'Multi-deck vibrating screens for material classification and sizing. 100 TPH and 150 TPH models. Manufactured in New Delhi by ARSM Engineering & Technology.';

const variants = [
  { name: 'Vibrating Screen 150 TPH', specs: [
    { label: 'Model', value: '150 TPH Heavy Duty' },
    { label: 'Screen Size', value: '16 ft x 5 ft (4.8 m x 1.5 m)' },
    { label: 'Decks', value: '2-Deck' },
    { label: 'Capacity', value: '150 TPH' },
    { label: 'Motor Power', value: '25 HP' },
    { label: 'RPM', value: '900 â€“ 1200 RPM' },
    { label: 'Screen Media', value: 'Polyurethane / SS Mesh' },
    { label: 'Amplitude', value: '4 â€“ 8 mm' },
    { label: 'Application', value: 'Aggregate sizing, mineral classification' },
  ]},
  { name: 'Vibrating Screen 100 TPH', specs: [
    { label: 'Model', value: '100 TPH Standard' },
    { label: 'Screen Size', value: '12 ft x 4 ft (3.6 m x 1.2 m)' },
    { label: 'Decks', value: '2-Deck' },
    { label: 'Capacity', value: '100 TPH' },
    { label: 'Motor Power', value: '15 HP' },
    { label: 'RPM', value: '900 â€“ 1000 RPM' },
    { label: 'Screen Media', value: 'Woven Wire / Polyurethane' },
    { label: 'Amplitude', value: '3 â€“ 6 mm' },
    { label: 'Application', value: 'Gravel, sand, coal screening' },
  ]},
];

const related = [
  { name: 'Jaw Crushers', description: 'Heavy-duty primary crushers for hard rock and ore processing.', price: 'From â‚¹5 Lakh', icon: 'ri-flashlight-line', href: '/products/jaw-crushers' },
  { name: 'Belt Conveyors', description: 'Flat, troughed & inclined belt conveyors for continuous material handling.', price: 'From â‚¹25,000', icon: 'ri-arrow-right-line', href: '/products/belt-conveyors' },
  { name: 'Crushing Plants', description: 'Complete mobile, skid-mounted & stationary crushing plant solutions.', price: 'From â‚¹5 Lakh', icon: 'ri-building-2-line', href: '/products/crushing-plants' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
  <div class="product-hero__img">
      <img src="/images/vibrating-screen.png" alt="ARSM 150 TPH Vibrating Screen - multi-deck classification" width="800" height="800" loading="eager" />
    </div>
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Vibrating Screens
      </p>
      <h1 class="product-hero__title">Vibrating Screens</h1>
      <p class="product-hero__desc">
        ARSM Engineering & Technology's vibrating screens are designed for high-efficiency material classification in mining, quarrying, and aggregate operations. With multi-deck configurations and durable screen media, they deliver precise sizing at capacities up to 150 TPH.
      </p>
      <p class="product-hero__desc">
        Built with heavy-duty vibratory motors and robust side plates, these screens withstand continuous operation in demanding environments. Available with polyurethane or woven wire screen media for different material types.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    </section>

  <section class="section">
    <div class="container">
      {variants.map((v) => (
        <div style="margin-bottom: var(--sp-6);">
          <h2 style="font-size: var(--fs-h3); font-weight: 700; color: var(--ink); margin-bottom: var(--sp-2);">{v.name}</h2>
          <SpecTable specs={v.specs} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Looking for a Screening Solution?" text="Tell us your material type and required output size." />
</Layout>