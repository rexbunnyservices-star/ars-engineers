---
import Layout from '../../layouts/Layout.astro';
import SpecTable from '../../components/SpecTable.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTA from '../../components/CTA.astro';

const title = 'Jaw Crushers | ARSM Engineering & Technology';
const desc = 'Heavy-duty jaw crushers for primary crushing. 80 TPH and 150 TPH models. Manufactured in New Delhi, India by ARSM Engineering & Technology.';

const variants = [
  { name: 'Jaw Crusher 150 TPH', specs: [
    { label: 'Model', value: '150 TPH Heavy Duty' },
    { label: 'Feed Opening', value: '400 x 600 mm' },
    { label: 'Capacity', value: '150 TPH' },
    { label: 'Motor Power', value: '100 HP' },
    { label: 'CSS Range', value: '40 mm â€“ 100 mm' },
    { label: 'Flywheel Speed', value: '275 RPM' },
    { label: 'Weight', value: '~12,000 kg' },
    { label: 'Material', value: 'Manganese Steel Jaw Plates' },
    { label: 'Application', value: 'Primary crushing of hard rock, ore, granite, basalt' },
  ]},
  { name: 'Jaw Crusher 80 TPH (Trolley Mounted)', specs: [
    { label: 'Model', value: '80 TPH Portable' },
    { label: 'Feed Opening', value: '200 x 300 mm' },
    { label: 'Capacity', value: '80 TPH' },
    { label: 'Motor Power', value: '40 HP' },
    { label: 'CSS Range', value: '20 mm â€“ 50 mm' },
    { label: 'Mounting', value: 'Trolley / Portable Skid' },
    { label: 'Weight', value: '~3,500 kg' },
    { label: 'Material', value: 'Manganese Steel Jaw Plates' },
    { label: 'Application', value: 'Portable crushing, small quarries, road construction' },
  ]},
];

const related = [
  { name: 'Hammer Crushers', description: 'High-impact secondary crushers for medium-hard materials.', price: 'Contact for Price', icon: 'ri-hammer-line', href: '/products/hammer-crushers' },
  { name: 'Roll Crushers', description: 'Double-roll crushers for fine and intermediate crushing stages.', price: 'Contact for Price', icon: 'ri-circle-line', href: '/products/roll-crushers' },
  { name: 'Crushing Plants', description: 'Complete mobile, skid-mounted & stationary crushing plant solutions.', price: 'From â‚¹5 Lakh', icon: 'ri-building-2-line', href: '/products/crushing-plants' },
];
---

<Layout title={title} description={desc}>
  <section class="product-hero">
    <div class="container">
      <p class="product-hero__breadcrumb">
        <a href="/">Home</a> / <a href="/#products">Products</a> / Jaw Crushers
      </p>
      <h1 class="product-hero__title">Jaw Crushers</h1>
      <p class="product-hero__desc">
        Our jaw crushers are the workhorses of primary crushing. Built with high-manganese steel jaw plates and robust mild steel frames, they deliver reliable performance in the toughest conditions â€” from quarrying granite to processing iron ore.
      </p>
      <p class="product-hero__desc">
        We offer two configurations: a high-capacity 150 TPH stationary unit for large operations, and a portable 80 TPH trolley-mounted unit for mobile crushing needs. Both models feature easy CSS adjustment and low maintenance requirements.
      </p>
      <div class="product-hero__actions">
        <a href="/#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get a Quote</a>
        <a href="/#products" class="btn btn--outline">View All Products</a>
      </div>
    </div>
    <div class="product-hero__img">
      <img src="/images/jaw-crusher.png" alt="ARSM Double Toggle Jaw Stone Crusher - 80 TPH and 150 TPH models" width="800" height="800" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      {variants.map((v) => (
        <div style="margin-bottom: var(--sp-6);">
          <h2 style="font-size: var(--fs-h3); font-weight: 700; color: var(--ink); margin-bottom: var(--sp-2);">{v.name}</h2>
          <SpecTable specs={v.specs} />
        </div>
      ))}
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <div class="section__head">
        <span class="section__label">Related Products</span>
        <h2 class="section__title">You May Also Need</h2>
      </div>
      <div class="related-grid">
        {related.map((p) => <ProductCard {...p} />)}
      </div>
    </div>
  </section>

  <CTA title="Need a Jaw Crusher?" text="We'll help you choose the right model for your capacity and material." />
</Layout>