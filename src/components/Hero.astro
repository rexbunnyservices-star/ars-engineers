---
---
<section class="section hero-section" id="home">
  <div class="container hero__inner">
    <div class="hero__content" data-reveal>
      <div class="hero__badges">
        <span class="badge badge--accent"><i class="ri-shield-check-line"></i> GST Registered</span>
        <span class="badge"><i class="ri-map-pin-line"></i> New Delhi, India</span>
      </div>
      <h1 class="hero__title">Precision Crushing, Conveying<br/>& Screening Solutions</h1>
      <p class="hero__text">Engineering reliable material handling equipment since 2014. Trusted by 100+ businesses across India. Manufacturer of belt conveyors, crushers, screens, grinding mills & complete plants.</p>
      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get Free Quote</a>
        <a href="#products" class="btn btn--outline">Explore Products</a>
      </div>
      <div class="hero__trust">
        <span class="hero__trust-chip">10+ Years</span>
        <span class="hero__trust-chip"><i class="ri-checkbox-circle-fill"></i> GST Registered</span>
        <span class="hero__trust-chip">Pan-India Delivery</span>
        <span class="hero__trust-chip">95% Response Rate</span>
      </div>
    </div>

    <div class="hero__visual" data-reveal>
      <div class="hero__photo">
        <img src="/images/crushing-plant.png" alt="ARSM Engineers crushing plant" width="500" height="500" />
      </div>
      <div class="hero__card hero__card--secondary">
        <div class="hero__card-icon hero__card-icon--sm"><i class="ri-arrow-right-up-line"></i></div>
        <span>Pan-India Logistics</span>
      </div>
      <div class="hero__card hero__card--accent">
        <div class="hero__card-icon hero__card-icon--sm hero__card-icon--white"><i class="ri-time-line"></i></div>
        <span>Fast Response</span>
      </div>
    </div>
  </div>
  <div class="hero__scroll"><i class="ri-arrow-down-line"></i></div>
</section>

<style>
  section.hero-section {
    background: linear-gradient(170deg, #f8f7f4 0%, #f0ede6 40%, #f8f7f4 100%);
    position: relative;
    overflow: hidden;
  }

  section.hero-section::before {
    content: '';
    position: absolute;
    top: 0;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(26,86,219,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  section.hero-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(26,86,219,0.15), transparent);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-8);
    align-items: center;
    min-height: calc(100vh - var(--nav-height));
    padding-top: var(--sp-8);
    position: relative;
    z-index: 1;
  }

  .hero__badges { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-4); flex-wrap: wrap; }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 900;
    color: var(--ink);
    line-height: 1.08;
    margin-bottom: var(--sp-3);
    letter-spacing: -0.02em;
  }

  .hero__title::after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    background: var(--gold);
    border-radius: 1px;
    margin-top: var(--sp-3);
    box-shadow: 0 0 12px rgba(0,180,215,0.3);
  }

  .hero__text {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--body);
    max-width: 500px;
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .hero__ctas { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-6); flex-wrap: wrap; }
  .hero__trust { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

  .hero__trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--body);
    box-shadow: var(--shadow-sm);
  }
  .hero__trust-chip i { color: var(--gold); }

  .hero__visual { position: relative; height: 420px; }

  .hero__photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 380px;
    height: 340px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 2px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__card {
    position: absolute;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-4);
    box-shadow: var(--shadow-md);
  }
  .hero__card--main h3 { font-size: var(--fs-h3); font-weight: 700; color: var(--ink); margin-bottom: var(--sp-1); }
  .hero__card--main p { font-size: var(--fs-small); color: var(--body); }
  .hero__card--secondary { bottom: 60px; left: 0; display: flex; align-items: center; gap: var(--sp-2); padding: 14px 20px; }
  .hero__card--secondary span { font-size: var(--fs-small); font-weight: 600; color: var(--ink); }
  .hero__card--accent { bottom: 0; right: 40px; background: var(--gold); border-color: var(--gold); display: flex; align-items: center; gap: var(--sp-2); padding: 14px 20px; box-shadow: 0 4px 24px rgba(0,180,215,0.3); }
  .hero__card--accent span { font-size: var(--fs-small); font-weight: 600; color: #fff; }

  .hero__card-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: var(--accent-light); border-radius: var(--radius-sm); color: var(--accent); font-size: 1.6rem; margin-bottom: var(--sp-3); }
  .hero__card-icon--sm { width: 36px; height: 36px; font-size: 1.1rem; margin-bottom: 0; }
  .hero__card-icon--white { background: rgba(255,255,255,0.25); color: #fff; }

  .hero__scroll {
    position: absolute;
    bottom: var(--sp-4);
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    font-size: 1.2rem;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (max-width: 960px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { display: none; }
    .hero__inner { min-height: auto; padding-top: calc(var(--sp-10) + var(--nav-height)); padding-bottom: var(--sp-8); }
  }
</style>
