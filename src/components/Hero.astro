---
---
<section class="section hero-section" id="home">
  <div class="hero-section__grid"></div>
  <div class="container hero__inner">
    <div class="hero__content" data-reveal>
      <div class="hero__badges">
        <span class="hero__badge"><i class="ri-shield-check-line"></i> GST Registered</span>
        <span class="hero__badge"><i class="ri-map-pin-line"></i> New Delhi, India</span>
      </div>
      <h1 class="hero__title">Precision Crushing, Conveying<br/>&amp; Screening Solutions</h1>
      <p class="hero__text">Engineering reliable material handling equipment since 2014. Trusted by 100+ businesses across India. Manufacturer of belt conveyors, crushers, screens, grinding mills &amp; complete plants.</p>
      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary"><i class="ri-chat-3-line"></i> Get Free Quote</a>
        <a href="#products" class="btn btn--outline btn--light">Explore Products</a>
      </div>
      <div class="hero__trust">
        <span class="hero__trust-chip">10+ Years</span>
        <span class="hero__trust-chip"><i class="ri-checkbox-circle-fill"></i> GST Registered</span>
        <span class="hero__trust-chip">Pan-India Delivery</span>
        <span class="hero__trust-chip">95% Response Rate</span>
      </div>
    </div>

    <div class="hero__visual" data-reveal>
      <div class="hero__photo-frame">
        <div class="hero__photo">
          <img src="/images/crushing-plant.png" alt="ARSM crushing plant manufactured in New Delhi" width="800" height="800" loading="eager" />
        </div>
      </div>
      <div class="hero__card hero__card--secondary">
        <div class="hero__card-icon hero__card-icon--sm"><i class="ri-road-map-line"></i></div>
        <div>
          <strong>Pan-India Logistics</strong>
          <span>Delivered across the country</span>
        </div>
      </div>
      <div class="hero__card hero__card--accent">
        <div class="hero__card-icon hero__card-icon--sm hero__card-icon--white"><i class="ri-time-line"></i></div>
        <div>
          <strong>Fast Response</strong>
          <span>Quotes within 24 hours</span>
        </div>
      </div>
    </div>
  </div>
  <div class="hero__scroll"><i class="ri-arrow-down-line"></i></div>
</section>

<style>
  section.hero-section {
    background: radial-gradient(1200px 600px at 75% -10%, rgba(0,180,215,0.16) 0%, transparent 60%),
                radial-gradient(900px 500px at 10% 110%, rgba(0,120,183,0.20) 0%, transparent 55%),
                linear-gradient(160deg, #020645 0%, #03045e 45%, #03206b 100%);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  /* Blueprint grid overlay */
  section.hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0,180,215,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,180,215,0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  section.hero-section::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,180,215,0.5), transparent);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--sp-8);
    align-items: center;
    min-height: calc(100vh - var(--nav-height));
    padding-top: var(--sp-8);
    position: relative;
    z-index: 1;
  }

  .hero__badges { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-4); flex-wrap: wrap; }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(0,180,215,0.35);
    border-radius: 100px;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: #bfe9ff;
    letter-spacing: 0.02em;
  }
  .hero__badge i { color: var(--gold); font-size: 1rem; }

  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 900;
    color: #fff;
    line-height: 1.08;
    margin-bottom: var(--sp-3);
    letter-spacing: -0.02em;
  }

  .hero__title::after {
    content: '';
    display: block;
    width: 80px;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), var(--accent));
    border-radius: 2px;
    margin-top: var(--sp-3);
    box-shadow: 0 0 16px rgba(0,180,215,0.6);
  }

  .hero__text {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: rgba(255,255,255,0.82);
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .hero__ctas { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-6); flex-wrap: wrap; }

  .btn--light {
    border: 2px solid rgba(255,255,255,0.45);
    color: #fff;
    background: transparent;
  }
  .btn--light:hover {
    background: rgba(255,255,255,0.12);
    border-color: var(--white);
    color: #fff;
  }

  .hero__trust { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

  .hero__trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 15px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
  }
  .hero__trust-chip i { color: var(--gold); }

  .hero__visual { position: relative; min-height: 460px; }

  .hero__photo-frame {
    position: absolute;
    top: 0;
    right: 6%;
    width: 400px;
    height: 360px;
    padding: 12px;
    background: linear-gradient(160deg, rgba(0,180,215,0.25), rgba(0,120,183,0.10));
    border: 1px solid rgba(0,180,215,0.35);
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.35);
  }

  .hero__photo {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    background: rgba(2,20,70,0.85);
    border: 1px solid rgba(0,180,215,0.3);
    border-radius: var(--radius);
    padding: var(--sp-3) var(--sp-4);
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    backdrop-filter: blur(10px);
  }
  .hero__card strong { display: block; font-size: 0.9rem; font-weight: 700; color: #fff; }
  .hero__card div > span { font-size: 0.72rem; color: rgba(255,255,255,0.7); }

  .hero__card--secondary { bottom: 90px; left: 0; }
  .hero__card--accent {
    bottom: 20px; right: 0;
    background: linear-gradient(135deg, #0078b7, #00a8d0);
    border-color: transparent;
  }
  .hero__card--accent div > span { color: rgba(255,255,255,0.9); }

  .hero__card-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: var(--accent-light); border-radius: var(--radius-sm); color: var(--gold); font-size: 1.2rem; }
  .hero__card-icon--white { background: rgba(255,255,255,0.22); color: #fff; }

  .hero__scroll {
    position: absolute;
    bottom: var(--sp-4);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.5);
    font-size: 1.2rem;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (max-width: 960px) {
    .hero__inner { grid-template-columns: 1fr; padding-top: calc(var(--sp-10) + var(--nav-height)); padding-bottom: var(--sp-8); min-height: auto; }
    .hero__visual { min-height: auto; margin-top: var(--sp-8); }
    .hero__photo-frame { position: relative; top: auto; right: auto; width: 100%; height: 300px; }
    .hero__card--secondary { bottom: 90px; left: 12px; }
    .hero__card--accent { bottom: 20px; right: 12px; }
  }

  @media (max-width: 480px) {
    .hero__visual { margin-top: var(--sp-6); }
    .hero__photo-frame { height: 240px; }
    .hero__card { padding: var(--sp-2) var(--sp-3); }
  }
</style>
