---
const links = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/#about' },
  { label: 'Products', href: '/#products' },
  { label: 'Why Us', href: '/#why-us' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo" aria-label="ARS Engineers Home">
      <svg width="36" height="36" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="64" height="64" rx="12" fill="#fafaf8" stroke="#e5e4e0" stroke-width="1"/>
        <text x="6" y="44" font-family="Inter,system-ui,sans-serif" font-weight="800" font-size="30" fill="#1a1a1a">ARS</text>
        <g transform="translate(46,6)">
          <circle cx="8" cy="8" r="7" fill="none" stroke="#e85d04" stroke-width="2"/>
          <circle cx="8" cy="8" r="2.5" fill="#e85d04"/>
          <line x1="8" y1="0" x2="8" y2="-1" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="8" y1="16" x2="8" y2="17" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="0" y1="8" x2="-1" y2="8" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="16" y1="8" x2="17" y2="8" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="2.3" y1="2.3" x2="1.3" y2="1.3" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="13.7" y1="13.7" x2="14.7" y2="14.7" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="2.3" y1="13.7" x2="1.3" y2="14.7" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="13.7" y1="2.3" x2="14.7" y2="1.3" stroke="#e85d04" stroke-width="1.8" stroke-linecap="round"/>
        </g>
      </svg>
      <div class="nav__logo-text">
        ARS
        <span>Engineers & Technology</span>
      </div>
    </a>

    <nav class="nav__links">
      {links.map((l) => (
        <a href={l.href} class="nav__link">{l.label}</a>
      ))}
    </nav>

    <a href="/#contact" class="btn btn--primary btn--sm nav__cta">Get Quote</a>

    <button class="nav__burger" id="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile">
    {links.map((l) => (
      <a href={l.href} class="nav__mobile-link">{l.label}</a>
    ))}
    <a href="/#contact" class="btn btn--primary" style="margin-top:1rem;text-align:center;">Get Quote</a>
  </div>
</header>

<script>
  const burger = document.getElementById('nav-burger');
  const mobile = document.getElementById('nav-mobile');
  if (burger && mobile) {
    burger.addEventListener('click', () => {
      burger.classList.toggle('open');
      mobile.classList.toggle('open');
    });
    mobile.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        burger.classList.remove('open');
        mobile.classList.remove('open');
      });
    });
  }
</script>
