---
const products = [
  {
    name: 'Belt Conveyors',
    desc: 'Flat, troughed & inclined belt conveyors for continuous material handling.',
    price: 'From ₹25,000',
    icon: 'ri-arrow-right-line',
    href: '/products/belt-conveyors',
  },
  {
    name: 'Jaw Crushers',
    desc: 'Heavy-duty primary crushers for hard rock and ore processing.',
    price: 'From ₹5 Lakh',
    icon: 'ri-flashlight-line',
    href: '/products/jaw-crushers',
  },
  {
    name: 'Vibrating Screens',
    desc: 'Multi-deck screens for efficient material classification and sizing.',
    price: 'From ₹1 Lakh',
    icon: 'ri-layout-grid-line',
    href: '/products/vibrating-screens',
  },
  {
    name: 'Screw Conveyors',
    desc: 'Inclined & vertical screw conveyors for bulk material transport.',
    price: 'From ₹1 Lakh',
    icon: 'ri-loop-right-line',
    href: '/products/screw-conveyors',
  },
  {
    name: 'Crushing Plants',
    desc: 'Complete mobile, skid-mounted & stationary crushing plant solutions.',
    price: 'From ₹5 Lakh',
    icon: 'ri-building-2-line',
    href: '/products/crushing-plants',
  },
  {
    name: 'Coal Crushers',
    desc: 'Specialized single-roll crushers designed for coal processing.',
    price: 'From ₹1.5 Lakh',
    icon: 'ri-fire-line',
    href: '/products/coal-crushers',
  },
  {
    name: 'Hammer Crushers',
    desc: 'High-impact secondary crushers for medium-hard materials.',
    price: 'Contact for Price',
    icon: 'ri-hammer-line',
    href: '/products/hammer-crushers',
  },
  {
    name: 'Roll Crushers',
    desc: 'Double-roll crushers for fine and intermediate crushing stages.',
    price: 'Contact for Price',
    icon: 'ri-circle-line',
    href: '/products/roll-crushers',
  },
];
---

<section class="section" id="products" data-num="02">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="section__label">Our Products</span>
      <h2 class="section__title">Complete Crushing & Conveying Range</h2>
      <p class="section__subtitle">From individual components to full turnkey plants, we manufacture everything your material handling operation needs.</p>
    </div>

    <div class="products__grid" data-reveal>
      {products.map((p) => (
        <a href={p.href} class="products__card">
          <div class="products__card-icon">
            <i class={p.icon}></i>
          </div>
          <h3 class="products__card-name">{p.name}</h3>
          <p class="products__card-desc">{p.desc}</p>
          <span class="products__card-price">{p.price}</span>
          <span class="products__card-link">View Details <i class="ri-arrow-right-s-line"></i></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }

  .products__card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-5);
    transition: transform var(--duration) var(--ease),
                box-shadow var(--duration) var(--ease),
                border-color var(--duration) var(--ease);
  }

  .products__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-accent);
  }

  .products__card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-light);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-size: 1.4rem;
    margin-bottom: var(--sp-3);
    transition: background var(--duration) var(--ease),
                color var(--duration) var(--ease);
  }

  .products__card:hover .products__card-icon {
    background: var(--accent);
    color: var(--white);
  }

  .products__card-name {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--sp-1);
  }

  .products__card-desc {
    font-size: var(--fs-small);
    color: var(--body);
    line-height: 1.6;
    flex: 1;
  }

  .products__card-price {
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent);
  }

  .products__card-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--sp-3);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    transition: color var(--duration) var(--ease), gap var(--duration) var(--ease);
  }

  .products__card:hover .products__card-link {
    color: var(--accent);
    gap: 8px;
  }

  @media (max-width: 960px) {
    .products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
