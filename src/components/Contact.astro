---
---
<section class="section" id="contact" data-num="04">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="section__label">Contact Us</span>
      <h2 class="section__title">Let's Talk About Your Project</h2>
      <p class="section__subtitle">Reach out for a free quote, product inquiry, or custom configuration. We respond within 24 hours.</p>
    </div>

    <div class="contact__grid" data-reveal>
      <form class="contact__form" id="contact-form">
        <div class="contact__form-row">
          <div class="form-group">
            <label class="form-label" for="name">Full Name *</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="phone">Phone Number *</label>
            <input class="form-input" type="tel" id="phone" name="phone" placeholder="+91 XXXXX XXXXX" required />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input class="form-input" type="email" id="email" name="email" placeholder="you@company.com" />
        </div>
        <div class="form-group">
          <label class="form-label" for="product">Product Interest</label>
          <select class="form-select" id="product" name="product">
            <option value="">Select a product...</option>
            <option>Belt Conveyors</option>
            <option>Jaw Crushers</option>
            <option>Vibrating Screens</option>
            <option>Screw Conveyors</option>
            <option>Crushing Plants</option>
            <option>Coal Crushers</option>
            <option>Hammer Crushers</option>
            <option>Roll Crushers</option>
            <option>Other / Multiple Products</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="message">Your Message *</label>
          <textarea class="form-textarea" id="message" name="message" placeholder="Tell us about your requirements..." required></textarea>
        </div>
        <button type="submit" class="btn btn--primary" style="width:100%;">
          <i class="ri-send-plane-line"></i> Send Message
        </button>
        <p class="contact__form-note" id="form-note" style="display:none;margin-top:var(--sp-2);font-size:var(--fs-small);color:var(--success);text-align:center;">
          <i class="ri-check-line"></i> Opening your email client…
        </p>
      </form>

      <div class="contact__info">
        <div class="contact__info-card">
          <div class="contact__info-icon"><i class="ri-map-pin-2-fill"></i></div>
          <div>
            <h4>Address</h4>
            <p>I.P. Extension, New Delhi,<br/>Delhi, India</p>
          </div>
        </div>

        <div class="contact__info-card">
          <div class="contact__info-icon"><i class="ri-phone-fill"></i></div>
          <div>
            <h4>Phone</h4>
            <a href="tel:+911204202899">+91 120 420 2899</a>
          </div>
        </div>

        <div class="contact__info-card">
          <div class="contact__info-icon"><i class="ri-mail-fill"></i></div>
          <div>
            <h4>Email</h4>
            <a href="mailto:info@arsengineers.in">info@arsengineers.in</a>
          </div>
        </div>

        <a href="https://wa.me/919871637116?text=Hi%2C%20I%27m%20interested%20in%20your%20crushing%20and%20conveying%20products.%20Can%20you%20share%20more%20details%3F"
           class="btn contact__whatsapp" target="_blank" rel="noopener">
          <i class="ri-whatsapp-fill"></i> Chat on WhatsApp
        </a>

        <div class="contact__map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3502.5!2d77.2906!3d28.6139!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390cfd5b347eb62d%3A0x52c2b7494e204d19!2sI.P.%20Extension%2C%20New%20Delhi%2C%20Delhi!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
            width="100%"
            height="220"
            style="border:0;border-radius:var(--radius-sm);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="ARS Engineers Location"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--sp-8);
    align-items: start;
  }

  .contact__form {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-6);
  }

  .contact__form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .contact__info-card {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
  }

  .contact__info-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-light);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .contact__info-card h4 {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .contact__info-card p,
  .contact__info-card a {
    font-size: var(--fs-small);
    color: var(--body);
    line-height: 1.6;
  }

  .contact__info-card a:hover {
    color: var(--accent);
  }

  .contact__whatsapp {
    background: #25d366;
    color: #fff;
    justify-content: center;
    padding: 14px 32px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    transition: background var(--duration) var(--ease);
  }

  .contact__whatsapp:hover {
    background: #1da851;
  }

  @media (max-width: 720px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact__form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const note = document.getElementById('form-note');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = fd.get('name') || '';
      const phone = fd.get('phone') || '';
      const email = fd.get('email') || '';
      const product = fd.get('product') || 'Not specified';
      const message = fd.get('message') || '';

      const subject = `Quote Request — ${name}`;
      const body = `Name: ${name}\nPhone: ${phone}\nEmail: ${email}\nProduct: ${product}\n\nMessage:\n${message}`;
      window.location.href = `mailto:info@arsengineers.in?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (note) note.style.display = 'block';
    });
  }
</script>
