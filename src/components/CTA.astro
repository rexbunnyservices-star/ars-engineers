---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to Upgrade Your Material Handling Setup?',
  text = "Get a free consultation with our engineering team. We'll help you find the perfect solution for your operations.",
} = Astro.props;
---

<section class="section cta-band">
  <div class="cta-band__pattern"></div>
  <div class="container" data-reveal>
    <div class="cta-band__inner">
      <div class="cta-band__content">
        <h2 class="cta-band__title">{title}</h2>
        <p class="cta-band__text">{text}</p>
      </div>
      <a href="/#contact" class="btn btn--white btn--sm">
        <i class="ri-chat-3-line"></i> Get Free Quote
      </a>
    </div>
  </div>
</section>
<style>
  .cta-band {
    background: var(--grad);
    padding: var(--sp-10) 0;
    position: relative;
    overflow: hidden;
  }

  .cta-band__pattern {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(0,180,215,0.04) 0px,
        rgba(0,180,215,0.04) 1px,
        transparent 1px,
        transparent 40px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(0,180,215,0.04) 0px,
        rgba(0,180,215,0.04) 1px,
        transparent 1px,
        transparent 40px
      );
    pointer-events: none;
  }

  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .cta-band__title {
    font-size: var(--fs-h2);
    font-weight: 800;
    color: #fff;
    margin-bottom: var(--sp-1);
  }

  .cta-band__text {
    font-size: var(--fs-body);
    color: rgba(255,255,255,0.85);
    max-width: 480px;
  }

  @media (max-width: 720px) {
    .cta-band__inner {
      flex-direction: column;
      text-align: center;
    }

    .cta-band__text {
      margin: 0 auto;
    }
  }
</style>
